{
  "name": "Call",
  "type": "object",
  "properties": {
    "caller_name": {
      "type": "string"
    },
    "caller_phone": {
      "type": "string"
    },
    "guest_id": {
      "type": "string"
    },
    "call_type": {
      "type": "string",
      "enum": [
        "\u0627\u0633\u062a\u0641\u0633\u0627\u0631",
        "\u062d\u062c\u0632 \u062c\u062f\u064a\u062f",
        "\u062a\u0639\u062f\u064a\u0644 \u062d\u062c\u0632",
        "\u0625\u0644\u063a\u0627\u0621",
        "\u0634\u0643\u0648\u0649",
        "\u0623\u062e\u0631\u0649"
      ],
      "default": "\u0627\u0633\u062a\u0641\u0633\u0627\u0631"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u0648\u0627\u0631\u062f\u0629",
        "\u0635\u0627\u062f\u0631\u0629",
        "\u0641\u0627\u0626\u062a\u0629",
        "\u0645\u0643\u062a\u0645\u0644\u0629"
      ],
      "default": "\u0648\u0627\u0631\u062f\u0629"
    },
    "duration_minutes": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string"
    },
    "follow_up_required": {
      "type": "boolean",
      "default": false
    },
    "follow_up_date": {
      "type": "string",
      "format": "date"
    },
    "reservation_id": {
      "type": "string"
    }
  },
  "required": [
    "caller_phone",
    "call_type",
    "status"
  ]
}